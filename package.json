{
  "name": "local-language-machine",
  "version": "1.0.4",
  "description": "All-in-one offline local AI coding — self-contained inference, no account, no API key.",
  "author": "Siroxou",
  "homepage": "https://github.com/siroxou/local-language-machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siroxou/local-language-machine.git"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "local-language-machine": "bin/local-language-machine.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "bench:data": "tsx bench/gen-dataset.ts",
    "bench": "tsx bench/run-matrix.ts",
    "preview": "tsx src/preview/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --mac --dir",
    "release": "npm run build && electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.siroxou.local-language-machine",
    "productName": "Local Language Machine",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs",
    "asar": false,
    "files": [
      "dist",
      "!node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/bins/${os}-${arch}*/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "node_modules/node-llama-cpp/llama/localBuilds/${os}-${arch}*/**/*",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}*/bins/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "siroxou",
        "repo": "local-language-machine",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "node-llama-cpp": "^3.19.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
