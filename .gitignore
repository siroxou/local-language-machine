# Dependencies
node_modules/

# Build output
dist/
build/
release/
*.tsbuildinfo

# Local tooling / editor cruft
.claude/
.vscode/
.idea/
.DS_Store

# Logs & secrets
*.log
# ...except the benchmark trainer output, which is the raw evidence behind the reports
!bench/*.log
.env
.env.*

# Benchmark resume state points at absolute run dirs, so it is machine-specific.
# The reports, experiment.json and trainer logs are committed; these are not.
bench/*/state.json

# One audit run's artifacts — trace, summary, report. Regenerated by `npm run audit`.
# audit/baseline.json IS committed: it is the ledger of what the gate currently accepts.
audit/last/

# Model cache lives in ~/.local-language-machine (outside the repo)
